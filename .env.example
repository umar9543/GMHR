# Where the dashboard sends its API calls. This is the ONLY place the address
# is set: every screen reads it through src/config-global.js.
#
#   local backend   https://gmsapi.scmcloud.online
#   live backend    https://gmsapi.scmcloud.online
#
# Copy this file to .env, set the address, and restart `npm run dev`.
# On Vercel set the same names under Settings > Environment Variables,
# because .env is not committed to git.

VITE_APP_API=https://gmsapi.scmcloud.online
VITE_APP_API_STORAGE=https://gmsapi.scmcloud.online
VITE_APP_URL=http://localhost:3030
